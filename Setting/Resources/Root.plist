<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>OptimizerX</string>
    <key>items</key>
    <array>

        <!-- CHẾ ĐỘ HIỆU NĂNG -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>🎯 CHẾ ĐỘ HIỆU NĂNG</string>
            <key>footerText</key><string>Chạm để chọn chế độ (Tiết kiệm, Cân bằng, Hiệu năng, Turbo). Áp dụng ngay tức thì.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>🎯 Chế độ: Đang tải...</string>
            <key>action</key><string>showModeMenu:</string>
            <key>id</key><string>currentModeCell</string>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>label</key><string>Thông số trực tiếp</string>
            <key>get</key><string>liveInfo:</string>
            <key>id</key><string>liveInfoCell</string>
        </dict>

        <!-- HUD -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>📊 HUD THÔNG SỐ</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Hiện HUD nổi</string>
            <key>key</key><string>showHUD</string>
            <key>default</key><true/>
        </dict>

        <!-- MƯỢT & NHẠY -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>✨ MƯỢT &amp; NHẠY</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Giảm animation</string>
            <key>key</key><string>reduceMotion</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Tăng tốc animation 1.5x</string>
            <key>key</key><string>fastAnimation</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Scroll mượt</string>
            <key>key</key><string>smoothScroll</string>
            <key>default</key><true/>
        </dict>

        <!-- NHIỆT ĐỘ -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>🌡️ NHIỆT ĐỘ</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Tự hạ mode khi nóng</string>
            <key>key</key><string>thermalAction</string>
            <key>default</key><true/>
        </dict>

        <!-- TỰ ĐỘNG -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>🚀 TỰ ĐỘNG</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Battery Guard</string>
            <key>key</key><string>batteryGuard</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>Ngưỡng pin (%)</string>
            <key>key</key><string>batteryThreshold</string>
            <key>default</key><real>20</real>
            <key>min</key><real>5</real>
            <key>max</key><real>50</real>
            <key>showValue</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>Ngưỡng nhiệt (°C)</string>
            <key>key</key><string>tempThreshold</string>
            <key>default</key><real>45</real>
            <key>min</key><real>35</real>
            <key>max</key><real>60</real>
            <key>showValue</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Tự động dọn cache</string>
            <key>key</key><string>autoClean</string>
            <key>default</key><false/>
        </dict>
        <dict>
            <key>cell</key><string>PSSliderCell</string>
            <key>label</key><string>Chu kỳ dọn (giây)</string>
            <key>key</key><string>autoCleanInterval</string>
            <key>default</key><real>3600</real>
            <key>min</key><real>600</real>
            <key>max</key><real>7200</real>
            <key>showValue</key><true/>
        </dict>

        <!-- MẠNG -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>🌐 MẠNG</string>
            <key>footerText</key><string>Đổi DNS sang Cloudflare. Có thể xung đột VPN.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Tối ưu mạng</string>
            <key>key</key><string>optimizeNetwork</string>
            <key>default</key><false/>
        </dict>

        <!-- THAO TÁC HỆ THỐNG -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>footerText</key><string>Nhấn để khởi động lại SpringBoard nếu cần làm mới toàn bộ giao diện.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>label</key><string>⚡ Respring Ngay</string>
            <key>action</key><string>respringPrompt</string>
        </dict>

        <!-- DISCLAIMER -->
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>⚠️ MIỄN TRỪ TRÁCH NHIỆM</string>
            <key>footerText</key><string>Tweak dùng cho mục đích tối ưu trải nghiệm. Tùy thuộc tình trạng phần cứng và nhiệt độ thực tế của máy.</string>
        </dict>

    </array>
</dict>
</plist>
